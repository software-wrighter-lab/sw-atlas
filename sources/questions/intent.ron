        (text: "what should i look at after the campus map", expect: [], intent: Recommend, origin: Teacher, status: Unconfirmed, note: "open: any building"),
        (text: "suggest a repository to read if i like interpreters", expect: [], intent: Recommend, origin: Teacher, status: Unconfirmed, note: "open"),
        (text: "what would you show someone who has never been here", expect: ["campus:campus"], intent: Recommend, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "anything good for a rust programmer curious about ml", expect: ["repo:sw-ml-study/sw-mlpl"], intent: Recommend, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "which video should i start with", expect: ["video:Zu3zreN8c0Q"], intent: Recommend, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "what next after the forth rabbit holes", expect: [], intent: Recommend, origin: Teacher, status: Unconfirmed, note: "open: the series continues"),

