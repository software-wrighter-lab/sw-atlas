// Questions that test what the visitor wants, not which resource answers.
//
// A set drafted to find the right resource teaches a model that every
// question is FindResource. This one exists so intent can be measured
// against something better than a constant.
QuestionSet(
    name: "intent",
    note: "Drafted 2026-09-24, unconfirmed. Written because AT01 measured a five-class intent head at 0.697 against a 0.737 always-FindResource baseline: 72% of the other sets are FindResource, so they cannot teach or measure intent. These rows are spread across the intents instead, so that a constant answer scores badly. The no-alias rule of the paraphrase set does NOT apply here -- an intent question may name its subject, because naming it is how a visitor asks whether a thing is finished or how two things differ. Scoring: intent on every row; destination only where a row names one, and `expect` is empty where the question is genuinely open. Compare is the intent A0's keyword rules cannot express at all, which is why it is here in numbers.",
    rows: [

        // --- Status ---
        (text: "is the card reader exhibit finished yet", expect: ["campus:ibm-1130"], intent: Status, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "how far along is the forth kernel", expect: ["blog:2026-04-20-embedded-forth-self-hosting-spectrum"], intent: Status, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "did you ever finish the sudoku app", expect: ["blog:2026-09-09-personal-software-sudoku-learn-practice"], intent: Status, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "what works today on the campus", expect: ["campus:campus"], intent: Status, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "is the apl interpreter usable or still a toy", expect: ["campus:apl"], intent: Status, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "has the fortran compiler for your chip started", expect: ["repo:sw-embed/sw-cor24-fortran"], intent: Status, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "what state is the home cluster in now", expect: ["blog:2026-02-28-lucy-20-percent-ai-cluster-upgrade"], intent: Status, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "is the tiny operating system running on real hardware yet", expect: ["repo:sw-embed/sw-tos"], intent: Status, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "how much of the pascal toolchain is working", expect: ["blog:2026-04-27-embedded-pascal-pcode-yagni-bump-to-reclaim"], intent: Status, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "which of the language experiments are actually finished", expect: ["campus:language-experiments"], intent: Status, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "is the index you are building usable yet", expect: ["blog:2026-09-20-saw-atlas-typed-decisions"], intent: Status, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "what is still planned rather than built", expect: [], intent: Status, origin: Teacher, status: Unconfirmed, note: "genuinely open: the answer is a list"),
        (text: "progress on the risc-v emulator", expect: ["repo:sw-embed/risc-v-rs"], intent: Status, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "is anything in the museum wing unfinished", expect: ["campus:computer-history"], intent: Status, origin: Teacher, status: Unconfirmed, note: ""),

        // --- Explain ---
        (text: "what is a bump allocator", expect: ["blog:2026-04-27-embedded-pascal-pcode-yagni-bump-to-reclaim"], intent: Explain, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "explain in-context learning to me", expect: ["blog:2026-02-22-icl-revisited-from-mystery-to-engineering"], intent: Explain, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "why does grokking happen at all", expect: ["blog:2026-04-23-mlf-05-grokking-delayed-generalization"], intent: Explain, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "what does a mixture of experts actually route", expect: ["blog:2026-09-13-saw-building-a-tiny-mixture-of-experts"], intent: Explain, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "how does your chip differ from a normal cpu", expect: ["blog:2026-03-22-cor24-rs-assembly-emulator"], intent: Explain, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "what is catastrophic forgetting", expect: ["blog:2026-02-25-how-ai-learns-part2-forgetting-vs-rot"], intent: Explain, origin: Teacher, status: Unconfirmed, note: ""),
