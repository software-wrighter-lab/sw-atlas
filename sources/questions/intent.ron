        (text: "explain what an engram cache does", expect: ["blog:2026-02-02-deepseek-papers-part2-engram"], intent: Explain, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "why do you keep every number regenerable", expect: [], intent: Explain, origin: Teacher, status: Unconfirmed, note: "a question about method, not a resource"),
