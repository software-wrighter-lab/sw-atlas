        (text: "i want the source for the campus itself", expect: ["repo:software-wrighter-lab/sw-campus"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "where do the language experiments live", expect: ["campus:language-experiments"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "get me to the processors exhibit", expect: ["campus:processors"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: ""),
