        (text: "suggest something to watch if i have five minutes", expect: [], intent: Recommend, origin: Teacher, status: Unconfirmed, note: "open: any short video is defensible"),
        (text: "i like old hardware, what should i see", expect: ["campus:computer-history"], intent: Recommend, origin: Teacher, status: Unconfirmed, note: ""),
