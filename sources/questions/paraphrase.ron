        (text: "the tiny eight bit chip that ended up on a spacecraft", expect: ["campus:rca-1802"], intent: FindResource, origin: Teacher, status: Unconfirmed, note: "the 1802 flew on Galileo; a visitor may only remember that"),
        (text: "where do i try the simulator for that low power seventies processor", expect: ["campus:rca-1802"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "the part of the site where chip designs are shown like exhibits", expect: ["campus:processors"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "where are the old computers", expect: ["campus:computer-history"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: "vaguest reasonable navigation question"),
        (text: "the building for embedded work and toolchains", expect: ["campus:computer-science"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "the wing where you keep the small made up languages", expect: ["campus:language-experiments"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "the notation with the greek letters you type sideways", expect: ["campus:apl"], intent: FindResource, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "i heard you can run iverson's notation in a web page here", expect: ["campus:apl"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: ""),

        // --- the throwback posts, remembered vaguely ---
        (text: "the story about betting on ponies in your first program", expect: ["blog:2026-01-29-tbt-apl-horse-race"], intent: Story, origin: Teacher, status: Unconfirmed, note: ""),
