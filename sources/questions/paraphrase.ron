        (text: "where do i try the simulator for that low power seventies processor", expect: ["campus:rca-1802"], intent: Navigate, origin: Teacher, status: Confirmed, note: ""),
        (text: "the part of the site where chip designs are shown like exhibits", expect: ["campus:processors"], intent: Navigate, origin: Teacher, status: Confirmed, note: ""),
