        (text: "the wing where you keep the small made up languages", expect: ["campus:language-experiments"], intent: Navigate, origin: Teacher, status: Confirmed, note: ""),
        (text: "the notation with the greek letters you type sideways", expect: ["campus:apl"], intent: FindResource, origin: Teacher, status: Confirmed, note: ""),
        (text: "i heard you can run iverson's notation in a web page here", expect: ["campus:apl"], intent: Navigate, origin: Teacher, status: Confirmed, note: ""),

        // --- the throwback posts, remembered vaguely ---
        (text: "the story about betting on ponies in your first program", expect: ["blog:2026-01-29-tbt-apl-horse-race"], intent: Story, origin: Teacher, status: Confirmed, note: ""),
