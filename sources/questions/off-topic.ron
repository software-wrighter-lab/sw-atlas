// Questions this corpus cannot answer, and must say so.
//
// `expect` is empty on every row: the correct answer is an admission.
// Unsupported recall is measured here, and it is the metric a confident
// system fails worst -- the campus matcher scores 1.00 on its own
// off-topic set and the trained docent scored 0.30.
//
// Three kinds on purpose: plainly unrelated, adjacent-but-absent (a real
// subject this author has never written about), and bait (wording that
// overlaps the corpus while asking something outside it).
QuestionSet(
    name: "off-topic",
    note: "Drafted 2026-09-22, unconfirmed. The corpus must abstain on all of these.",
    rows: [
        (text: "what is the weather tomorrow", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "plainly unrelated"),
        (text: "book me a table for two at eight", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "who won the cup final", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "how do i get a mortgage", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "translate this into portuguese", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "write me a poem about autumn", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "asks for prose the model must never produce"),
        (text: "what do you think of my code", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "invites an opinion nothing in the corpus supports"),
        (text: "your posts about kubernetes operators", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "adjacent but absent"),
        (text: "the article where you cover react hooks", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "adjacent but absent"),
        (text: "your work on quantum error correction", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "adjacent but absent"),
        (text: "what did you write about ios app review", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "adjacent but absent"),
        (text: "the piece on database sharding at scale", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "adjacent but absent"),
        (text: "where can i buy the ibm 1130", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "bait: names a real exhibit, asks something impossible"),
        (text: "will you fix the bug in my forth interpreter", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "bait: corpus vocabulary, request outside the corpus"),
        (text: "what is apl's market share", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "bait"),
        (text: "how much does your home ai cluster cost to run per month", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "bait: the cluster is in the corpus, the figure is not"),
        (text: "can you train a model for my company", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "bait"),
        (text: "which of your repositories has the most stars", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: "bait: the cache holds star counts, the corpus deliberately does not"),
        (text: "what is the population of denmark", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "explain the offside rule", expect: [], intent: Unsupported, origin: Teacher, status: Unconfirmed, note: ""),
    ],
)
