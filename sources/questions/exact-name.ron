// Questions that name the thing outright.
//
// The matcher's home ground, and the set that stops a reranker from being
// called an improvement when it has quietly made the easy cases worse. A
// hybrid that gains ten points on paraphrases and loses five here has not
// improved; the regression list in the harness reads from this set first.
QuestionSet(
    name: "exact-name",
    note: "Drafted 2026-09-22, unconfirmed. Aliases and titles appear verbatim on purpose here.",
    rows: [
        (text: "where is the IBM 1130 wing", expect: ["campus:ibm-1130"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "take me to the APL exhibit", expect: ["campus:apl"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "RCA COSMAC 1802", expect: ["campus:rca-1802"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: "bare name, no sentence"),
        (text: "show me sw-checklist", expect: ["repo:softwarewrighter/sw-checklist"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "moe-microscope", expect: ["repo:sw-ml-study/moe-microscope"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "where is sw-cor24-apl", expect: ["repo:sw-embed/sw-cor24-apl"], intent: Navigate, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "the Tiny Recursive Model post", expect: ["blog:2026-01-31-small-models-part1-tiny-recursive-model"], intent: FindResource, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "Engram Revisited", expect: ["blog:2026-02-11-deepseek-papers-part3-engram-revisited"], intent: FindResource, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "midi-cli-rs", expect: ["blog:2026-02-20-midi-cli-rs-music-for-ai-agents"], intent: FindResource, origin: Teacher, status: Unconfirmed, note: "the tool is named in two posts; the first is expected"),
        (text: "XSkill", expect: ["blog:2026-03-17-ai-tools-xskill-memory-layer-multimodal-agents"], intent: FindResource, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "Grokking", expect: ["blog:2026-04-23-mlf-05-grokking-delayed-generalization"], intent: FindResource, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "wiki-rs", expect: ["blog:2026-03-26-tbt-wiki-rs-six-wikis"], intent: FindResource, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "Five ML Concepts #11", expect: ["blog:2026-02-14-five-ml-concepts-11"], intent: FindResource, origin: Teacher, status: Unconfirmed, note: "the post; the video is a defensible second answer"),
        (text: "neural collapse", expect: ["blog:2026-03-09-mlf-01-neural-collapse"], intent: FindResource, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "pjmai-rs", expect: ["blog:2026-03-05-tbt-pjmai-rs-project-manager"], intent: FindResource, origin: Teacher, status: Unconfirmed, note: ""),
        (text: "the COR24 assembly emulator", expect: ["blog:2026-03-22-cor24-rs-assembly-emulator"], intent: FindResource, origin: Teacher, status: Unconfirmed, note: ""),
    ],
)
